{
  "name": "terra-exploration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:offline": "node scripts/run-offline.mjs dev",
    "build": "tsc -b && vite build",
    "build:offline": "node scripts/run-offline.mjs build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:offline": "node scripts/run-offline.mjs preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run test && npm run build",
    "format": "prettier --write src tests scripts vite.config.ts index.html",
    "format:check": "prettier --check src tests scripts vite.config.ts index.html",
    "licenses": "node scripts/generate-licenses.mjs",
    "prts:sync": "node scripts/sync-prts.mjs",
    "prts:build": "node scripts/sync-prts.mjs --phase=build --offline",
    "prts:assets": "node scripts/prts-assets.mjs sync",
    "prts:verify-assets": "node scripts/prts-assets.mjs verify",
    "prts:verify": "node scripts/prts/verify.mjs",
    "prts:online": "node scripts/publish-online.mjs --output=resources/online",
    "prts:thumbnails": "node scripts/fetch-online-thumbnails.mjs",
    "assets:pack": "node scripts/assets/cli.mjs pack",
    "assets:download": "node scripts/assets/cli.mjs download",
    "assets:verify": "node scripts/assets/cli.mjs verify"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "sharp": "0.35.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
