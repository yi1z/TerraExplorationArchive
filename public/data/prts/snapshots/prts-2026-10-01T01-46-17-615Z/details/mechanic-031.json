{"records":[{"id":"prts-mechanic-63610","kind":"mechanic","name":"阻流阀","en":"Throttle Valve","aliases":["阻流阀"],"summary":"阻流阀是我方障碍物。部署条件：部署于近战位。","summaryStatus":"source","tags":["关卡装置","障碍物"],"releaseStatus":"released","source":{"title":"阻流阀","url":"https://prts.wiki/w/%E9%98%BB%E6%B5%81%E9%98%80","pageId":63610,"revisionId":417899,"timestamp":"2026-08-15T05:13:30Z","publisher":"PRTS 玩家社区 / 游戏资料"},"facts":[{"label":"实体类型","value":"障碍物"},{"label":"阵营","value":"我方"},{"label":"部署条件","value":"部署于近战位"},{"label":"部署费用","value":"5"},{"label":"阻挡数","value":"0"},{"label":"占用部署数","value":"0"},{"label":"撤回策略","value":"部署后可撤回"}],"sections":[],"relationships":[],"fields":{"identity":{"装置id":"trap_139_dhtl","名称":"阻流阀","英文名":"Throttle Valve","阶段1等级":"1","阶段1生命值":"100","阶段1攻击力":"0","阶段1防御力":"0","阶段1法术抗性":"0.0","部署费用":"5","阻挡数":"0","攻击间隔":"1.0","再部署时间":"5","技力恢复速度":"1.0","嘲讽等级":"0","眩晕抗性":"无","沉默抗性":"无","沉睡抗性":"无","冻结抗性":"无","阶段2等级":"30","阶段2生命值":"100","阶段2攻击力":"0","阶段2防御力":"0","阶段2法术抗性":"0.0","实体类型":"障碍物","阵营":"我方","阻挡半径":"0.7071","重写地块":"否","再部署策略":"默认","占用部署数":"0","部署条件":"部署于近战位","撤回策略":"部署后可撤回"}},"templates":[{"name":"装置信息","params":{"装置id":"trap_139_dhtl","名称":"阻流阀","英文名":"Throttle Valve","阶段1等级":"1","阶段1生命值":"100","阶段1攻击力":"0","阶段1防御力":"0","阶段1法术抗性":"0.0","部署费用":"5","阻挡数":"0","攻击间隔":"1.0","再部署时间":"5","技力恢复速度":"1.0","嘲讽等级":"0","眩晕抗性":"无","沉默抗性":"无","沉睡抗性":"无","冻结抗性":"无","阶段2等级":"30","阶段2生命值":"100","阶段2攻击力":"0","阶段2防御力":"0","阶段2法术抗性":"0.0","实体类型":"障碍物","阵营":"我方","阻挡半径":"0.7071","重写地块":"否","再部署策略":"默认","占用部署数":"0","部署条件":"部署于近战位","撤回策略":"部署后可撤回","装置机制":"仅在有<病害值>机制的关卡中出现。\n* 建成后隔断地面地块，使四周的田地地块无法通过自身所在地块传播病害。\n: 令所在地形的实际病害值/缓存病害值变为0且不视为田地地块；被分隔的连片田地各自以当前的最高实际病害值作为当前最大病害值。\n* 关卡地图预览中的阻流阀开局均处于已建成状态。\n* 身处已建成的阻流阀上的敌方单位将获得免疫、反制、免疫、反制（不可对空）。"}},{"name":"装置技能","params":{"技能名":"阻流","技能类型1":"被动","技能范围":"0-1","技能1初始":"1","技能1消耗":"1","技能1持续":"3","技能1描述":"3秒后建成，阻隔水流","备注":"* 此技能用于由玩家手动部署的阻流阀\n* 部署后自身生命值降至最大生命值的3.4%，并在3秒内逐渐提升至最大值，期间持有无敌"}},{"name":"装置技能","params":{"技能名":"阻流","SMW":"阻流已部署","技能类型1":"被动","技能范围":"0-1","技能1初始":"0","技能1消耗":"0","技能1描述":"阻隔水流","备注":"* 此技能用于关卡开始时已自动部署的阻流阀"}}],"artworkRefs":[],"facets":{"type":["关卡装置"]},"missingFacts":[],"facet":"关卡装置","structuralStatus":"complete","detailShard":"data/prts/snapshots/prts-2026-10-01T01-46-17-615Z/details/mechanic-031.json"},{"id":"prts-mechanic-69344","kind":"mechanic","name":"尊主的残影","en":"Master's Shade","aliases":["尊主的残影"],"summary":"尊主的残影是敌方默认。部署条件：部署于近战/远程位。","summaryStatus":"source","tags":["关卡装置","默认"],"releaseStatus":"released","source":{"title":"尊主的残影","url":"https://prts.wiki/w/%E5%B0%8A%E4%B8%BB%E7%9A%84%E6%AE%8B%E5%BD%B1","pageId":69344,"revisionId":365669,"timestamp":"2025-09-14T13:08:36Z","publisher":"PRTS 玩家社区 / 游戏资料"},"facts":[{"label":"实体类型","value":"默认"},{"label":"阵营","value":"敌方"},{"label":"部署条件","value":"部署于近战/远程位"},{"label":"部署费用","value":"5"},{"label":"阻挡数","value":"0"},{"label":"占用部署数","value":"0"},{"label":"撤回策略","value":"部署后可撤回"}],"sections":[],"relationships":[],"fields":{"identity":{"装置id":"trap_761_skzthx","名称":"尊主的残影","英文名":"Master's Shade","装置头像":"无","阶段1等级":"1","阶段1生命值":"12000","阶段1攻击力":"1500","阶段1防御力":"0","阶段1法术抗性":"0.0","部署费用":"5","阻挡数":"0","攻击间隔":"1.0","再部署时间":"5","技力恢复速度":"1.0","嘲讽等级":"0","眩晕抗性":"无","沉默抗性":"无","沉睡抗性":"无","冻结抗性":"无","阶段2等级":"30","阶段2生命值":"12000","阶段2攻击力":"1500","阶段2防御力":"0","阶段2法术抗性":"0.0","实体类型":"默认","阵营":"敌方","阻挡半径":"0.7071","重写地块":"否","再部署策略":"默认","占用部署数":"0","部署条件":"部署于近战/远程位","撤回策略":"部署后可撤回","天赋名称":"挥砍"}},"templates":[{"name":"装置信息","params":{"装置id":"trap_761_skzthx","名称":"尊主的残影","英文名":"Master's Shade","装置头像":"无","阶段1等级":"1","阶段1生命值":"12000","阶段1攻击力":"1500","阶段1防御力":"0","阶段1法术抗性":"0.0","部署费用":"5","阻挡数":"0","攻击间隔":"1.0","再部署时间":"5","技力恢复速度":"1.0","嘲讽等级":"0","眩晕抗性":"无","沉默抗性":"无","沉睡抗性":"无","冻结抗性":"无","阶段2等级":"30","阶段2生命值":"12000","阶段2攻击力":"1500","阶段2防御力":"0","阶段2法术抗性":"0.0","实体类型":"默认","阵营":"敌方","阻挡半径":"0.7071","重写地块":"否","再部署策略":"默认","占用部署数":"0","部署条件":"部署于近战/远程位","撤回策略":"部署后可撤回","天赋名称":"挥砍","天赋描述":"与特雷西斯，黑冠尊主同时向前砍出剑气","装置机制":"*不可阻挡，不进行普通攻击，出场250s后自动退场\n*【挥砍】：蓄力约9s后，向自身部署方向挥砍出剑气，剑气碰撞半径0.5，对碰撞到的我方单位造成攻击力150%的物理伤害\n: ※【挥砍】仅可由特雷西斯，黑冠尊主/特雷西斯(装置)触发"}}],"artworkRefs":[],"facets":{"type":["关卡装置"]},"missingFacts":[],"facet":"关卡装置","structuralStatus":"complete","detailShard":"data/prts/snapshots/prts-2026-10-01T01-46-17-615Z/details/mechanic-031.json"},{"id":"prts-mechanic-13230","kind":"mechanic","name":"作战机制","en":"","aliases":["作战机制"],"summary":"作战机制的玩法资料，包含18组数据表、0组规则参数。","summaryStatus":"source","tags":[],"releaseStatus":"released","source":{"title":"作战机制","url":"https://prts.wiki/w/%E4%BD%9C%E6%88%98%E6%9C%BA%E5%88%B6","pageId":13230,"revisionId":429083,"timestamp":"2026-09-25T17:00:15Z","publisher":"PRTS 玩家社区 / 游戏资料"},"facts":[],"sections":[],"relationships":[],"fields":{"headings":["公共机制","索敌的概念","“隐匿”","攻击范围","视野范围","职业与分支","部署费用与待部署区","伤害、Buff与计算","伤害及其处理","生命值","AOE伤害判定的本质逻辑","Buff判定与可选性","加Buff的原理","隐匿与Buff的关系","技能、天赋与沉默","伤害计算","伤害红字（暴击）","红字计算举例","强制红字与蓝字","就近取整：四舍六入五成双","伤判效果与生命流失","符文","敌人类单位行动与坐标","行动的基本原理","传送","地穴","行动受阻","闪现","敌人模型","碰撞体积与位置识别","敌人朝向与相对方位","扩展阅读：波次","扩展阅读：地块","部署类型与合法部署行为","地形TAG","敌方的位移","代理运行与判定机制","代理失误","原因1：干员能力变化","原因2：丢帧","原因3：版本更新","原因4：特殊怪物能力","玩家操作的代理原理","随机事件的代理原理"],"sourceType":"gameplay-reference","tables":[{"title":"伤害及其处理","rows":[["流程顺序","流程名称","流程内容","应用举例"],["1","来源实体事件：ON_CALCULATE_DAMAGE。","获取modifier的各项属性，计算伤害并生成modifier","攻击倍率调整"],["2","准备向目标实体应用modifier，检查modifier是否被cancel"],["3","目标实体事件：ON_BEFORE_APPLYING_MODIFIER"],["4","来源实体事件：ON_OUTPUT_MODIFIER","检查来源有效性。","造成治疗倍率调整"],["5","检查modifier目的，","为伤害时执行来源实体事件：ON_OUTPUT_DAMAGE","伤害倍率调整"],["6","目标实体事件：ON_APPLYING_MODIFIER","受治疗倍率调整"],["7","执行On_Take_Damage/On_Take_Heal","1.取消掉隐匿/无敌状态下的攻击\n2.取消试图非强制治疗不可治疗单位的治疗\n\n3.检测modifier是否被cancel，反伤，闪避，抵挡，护盾。","未被cancel时对目标应用modifier"],["8","应用成功后，","执行目标实体事件ON_APPLIED_MODIFIER"],["9","检查modifier目的，","为伤害时执行来源实体事件：ON_AFTER_OUTPUT_DAMAGE","成功造成伤害为条件的效果触发判定"]]},{"title":"伤害及其处理","rows":[["因陀罗闪榴莲针"],["我刚刚闪了个什么？"],["现象：阿的远程攻击触发了因陀罗的近战攻击闪避天赋。"],["原理：攻击类型属于远程还是近战，是攻击属性数据里面的其中一项，用两位二进制数存储，无是00(0)，近战是01(1)，远程是10(2)，近+远是11(3)。\n在检查特效是否生效的时候，就用检测条件与远近数据进行“与”运算，之后看是否有变化，无变化则认为是近战，比如01&01=01（条件近战-数据近战，不变，判定成功），01&10=00（条件近战-数据远程，变了，判定失败）。\n但是，阿的攻击因为伤害固定，做了特殊处理，伤害类型为00（无），01&00=00，无变化，所以被认成了近战，于是触发了闪避。\n以及，有弹道的攻击固定为10，无弹道的攻击固定为01，所以无人机的无弹道远程攻击也可能会被闪避。"]]},{"title":"伤害及其处理","rows":[["被护盾挡下的增伤拐"],["我红字呢？"],["现象：部分情况下，泥岩的法术屏障存在时，会使其受到的法术伤害吃不到伤害加成。"],["原理：很明显，这二者在执行时并不会相互调用。\n先结算屏障时，如果只抵消一部分，伤害倍率提升由于其逻辑只会对抵消后的modifier值生效；\n先结算伤害倍率提升时，modifier值会被增加，屏障值的扣减也会被伤害倍率提升加成。\n由于这二者的行为位于一个行动节点，按照鹰角目前的逻辑，其行动会按照其在buffContainer中的顺序(绝大部分时候为添加顺序)进行结算，也就是说：\n先加屏障，再加易伤，护盾吃不到伤害加成，\n先加易伤，再加屏障，护盾可以吃到伤害加成。\n 关于这类伤判效果的先后顺序现在已经有了更详细的解释，详见伤判效果一节。"]]},{"title":"隐匿与Buff的关系","rows":[["与隐匿状态的联动"],["在睡眠之歌里蹦迪"],["现象：1.当隐匿敌人在进入空的“睡眠之歌”作用区域后因为被阻挡而显形不会使敌人进入沉睡状态。\n2.在三秒显形时间内使敌人再次进入作用区域时，会进入沉睡状态，但隐匿恢复后的敌人会解除沉睡状态。"],["原理：在以隐匿状态进入buff区域后被阻挡显形无法触发目标更新机制，不会受到buff的影响。\n 此内容已在2020年3月17日的更新中被修复。"]]},{"title":"隐匿与Buff的关系","rows":[["与无敌状态的联动"],["叠满Debuff的三级弑君者&龟速霜星"],["现象：1.在弑君者位移前摇时施加buff，如果位移后离开buff范围，则该buff在干员在场的情况下可无视攻击范围限制无限持续。\n2.满足现象1的弑君者再次踏入同名buff中后，该buff在干员不在场的情况下也可无限持续。\n3.延伸：用上述同样的办法，让霜星获得了永续停顿状态，移动速度降低到0.1的下限。"],["原理：（以弑君者为例）\n# 弑君者施放技能时处于\"无敌\"状态，进入光环范围。\n此时单位会被添加至m_invalidTarget列表中。\n# 弑君者离开光环范围，解除\"无敌\"状态。\n此时光环能力执行OnTick函数时，由于目标仍处在m_invalidTarget列表中，因此会被_DoTargetCheckAndEnter函数检查条件。\n由于这个时候是符合条件的，因此弑君者会被添加buff，并被登记在m_targetMap字典中（即使处在范围外）。随后目标从m_invalidTarget列表中移除 (即达到buff在干员在场的情况下可无视攻击范围限制无限持续）。\n# 弑君者再次进入光环范围，撤离干员，受到的光环效果永久持续。\n此时会再次触发OnTriggerEnter2D函数并被添加buff（但是因为同名buff的默认叠加策略buff只能表现出一个），并登记在m_targetMap字典中。\n但因为m_targetMap是字典，因此在登记的时候，键（key）还是不变的实体指针，值（value）已经被替换成了新buff的uid，而旧buff的uid因此被遗失（类似内存泄露）。\n最后，不管光环能力通过什么手段试图结束buff，被结束的都只是新buff。而旧buff由于并不处于m_targetMap字典上，因此脱离了光环能力的掌控而永久生效。\n 此内容已在2020年8月25日的更新中被修复。"]]},{"title":"伤害计算","rows":[["计算顺序（从上到下）"],["数据类型","计算方式","描述举例","叠加算法"],["面板与伤害","直接加算","阿“攻击速度+100”","\\(X_1=X+a_1+a_2\\)"],["直接乘算","黑“攻击力+180%”","\\(X_2=X_1(1+b_1\\%+b_2\\%)\\)"],["最终加算","空“获得相当于空100%攻击力的鼓舞效果”","\\(X_3=X_2+c_1+c_2\\)"],["最终乘算","推进之王“攻击时攻击力提高至380%”\n\n梅尔“爆炸时对周围敌人造成相当于梅尔攻击力600%的法术伤害”","\\(X_4=X_3\\times d_1\\%\\times d_2\\%\\)"],["敌方属性","直接加算","伊芙利特“命中目标在3秒内防御力-300”","\\(Y_1=Y+a_1+a_2\\)"],["直接乘算","“5秒内使击中目标攻击力-40%”","\\(Y_2=Y_1(1+b_1\\%+b_2\\%)\\)"],["最终加算","慑砂“并在3秒内使目标攻击速度-20”","\\(Y_3=Y_2+c_1+c_2\\)"],["最终乘算","槐琥“并使被攻击目标在3秒内攻击力-40%”","\\(Y_4=Y_3\\times(1+d_1\\%)\\times(1+d_2\\%)\\)"],["最终效果"],["伤害乘算","铁钳号·原型机“受到的伤害减少100%”","\\(\\text{百分比相加}\\)"],["伤害重写","铜灯盘“需要35次伤害击倒”（特殊生命值机制）","\\(\\text{重写}\\)"]]},{"title":"红字计算举例","rows":[["计算流程"],["*攻击力=老鲤面板899×(1+不稳定血浆0.9+爆发剂·榴莲味0.5+精力充沛0.5+协同作战0.36+青色怒火0.14+战术整理·VI0.2)+“潮涌，潮枯”445×(1+0.09+0.14)×1.1=3838.485\n:爱国者法抗=(面板0.45-灼地0.2-冻结0.15)×(1+行军姿态1)×精神融解0.56=0.112\n:期望伤害=攻击力×二技能叠满倍率9×(1-爱国者法抗0.112)=34546.365\n:最终伤害=攻击力×二技能叠满倍率9×(1-爱国者法抗0.112)×钙质化1.55×支援地雷1.5×灵知第一天赋1.54=109839.61477566\n*最终伤害≥1.5×期望伤害，所以显示红字，最终显示结果为最终伤害进位后的109840。\n: 在这一案例中，因为老鲤不具备贯穿能力，故公式可以化简，直接计算钙质化、支援地雷、灵知第一天赋三者提供伤害倍率加成：\n: 伤害倍率=钙质化1.55×支援地雷1.5×灵知第一天赋1.54=3.5805≥1.5，所以显示红字。"]]},{"title":"红字计算举例","rows":[["计算流程"],["{[断罪者攻击力888×(1+活性源石50%+阿榴莲针50%+华法琳血怒90%+诗怀雅天赋36%+近卫小车天赋20%+近卫阿米娅天赋14%)+浊心斯卡蒂攻击力445×(1+浊心斯卡蒂天赋18%+波登可天赋11%+近卫阿米娅天赋14%)×技能倍率110%]×合约加成200%×伤害倍率800%-泥岩巨像防御力600}×慑砂天赋116%×W天赋121%×巫恋天赋[1+(33%×一技能1.8)]=138152.424433"]]},{"title":"红字计算举例","rows":[["计算流程"],["{[扼喉之手攻击力999999×文明的存续(1+150%)×支援地雷(1+50%)×灵知第一天赋[1+(32%×2)]=6149993.85"]]},{"title":"红字计算举例","rows":[["计算流程"],["*目标防御力=((220-高爆弹头210)×(1-碎甲箭0.35)×(1-聆听0.25)×(1-诅咒娃娃0.5))=2.4375\n: “攻击力”=目标防御力=2.4375\n:期望伤害=“攻击力”×刻俄柏剥壳0.4×(1-目标的法抗0)=0.975。\n:最终伤害=“攻击力”×刻俄柏剥壳0.4×(1-目标的法抗0)×钙质化1.5×(1-目标的法抗0)=1.4625\n*最终伤害≥1.5×期望伤害，所以显示红字，最终显示结果为期望伤害=退位后的1。\n需要特别说明的是，这个“1”实际为刻俄柏的天赋“剥壳”造成的法术伤害，实际给予的伤害还包括三技能打出的物理伤害，因此被击中的暴鸰·G依旧被击倒。"]]},{"title":"强制红字与蓝字","rows":[["样例：低练度谜图攻击特蕾西娅"],[""],["在本例中：\n* 谜图的养成状态为：精英1 Lv.1 技能等级Rank.1 信赖值0%\n* 作战场地为14-21（标准）\n此时：\n*攻击力=谜图面板352\n:期望伤害=攻击力× 满层倍率(0.06×10) × (1-特蕾西娅法术抗性0.6) = 84.48\n:最终伤害=攻击力× 满层倍率(0.06×10) × × (1-特蕾西娅法术抗性0.6) × (1-特蕾西娅减伤率0.9) × (1-魂灵圣杯分担0.95) = 0.4224\n*最终伤害＜1.5×期望伤害，但此时仍显示红字，并在取整后显示为0。"]]},{"title":"行动的基本原理","rows":[["路径点事件指令"],["TypeID","ID","事件名","备注"],["0","MOVE","移动","移动到指定位置后执行下一步"],["1","WAIT_FOR_SECONDS","停驻(到位置后计时)","等待一定时间后执行下一步"],["2","WAIT_FOR_PLAY_TIME","停驻(全局计时)","全局时间达到一定值后执行下一步"],["3","WAIT_CURRENT_FRAGMENT_TIME","停驻(兵团行动开始后计时)","当前兵团开始后时间达到一定值后执行下一步"],["4","WAIT_CURRENT_WAVE_TIME","停驻(波次行动开始后计时)","当前波次开始后时间达到一定值后执行下一步"],["5","DISAPPEAR","进入传送","进入消失状态(无敌且透明，发生任意移动后取消)并等待一定时间后执行下一步"],["6","APPEAR_AT_POS","离开传送","离开消失状态，瞬移到指定位置后执行下一步"],["7","ALERT","警报","可能作用于多维合作中，用于敌人进入下层时触发下层警告特效"],["8","PATROL_MOVE","巡逻","于2023年1月29日首次加入并应用的路径指令\n经过后不会从路径点序列中消失的路径点，会被敌人单位重复经过\n存在巡逻路径点时，敌人单位将始终留在战场上沿闭合路径移动，除非其因某些特殊能力退场"],["9","WAIT_BOSSRUSH_WAVE","引航者试炼-休整","于2023年8月1日首次加入，于2023年8月24日首次应用的路径指令\n将自身移出当前波次，于下x个波次后被移入并执行下一步，以当前状态重新出现\n也即未能击杀的场合进行休整，于下个波次继续追击"]]},{"title":"扩展阅读：波次","rows":[["小队动作指令"],["TypeID","ID","事件名","备注"],["0","SPAWN","召唤","将对应的敌人召唤到场上（即“出生”）"],["1","PREVIEW_CURSOR","显示路径","以红/黄线形式显示绑定的路线"],["2","STORY","播放浮窗剧情","读取对应的浮窗剧情 并在关卡显示"],["3","TUTORIAL","？","？"],["4","PLAY_BGM","播放BGM","暂停当前BGM并播放指定的BGM"],["5","DISPLAY_ENEMY_INFO","显示敌人信息","在画面右上角弹框显示敌人信息"],["6","ACTIVATE_PREDEFINED","预部署单位生效(干员)","使预部署但隐藏的单位立刻部署"],["7","PLAY_OPERA","播放画面特效","执行特殊的画面效果"],["8","TRIGGER_PREDEFINED","预部署单位生效(装置)","使预部署但隐藏的装置立刻部署"],["9","BATTLE_EVENTS","战斗事件","执行特定战斗内事件"],["10","WITHDRAW_PREDEFINED","预部署单位撤回","使在场特定预部署单位立刻撤退"],["11","DIALOG","播放局内演出剧情","读取对应的局内演出剧情 并在关卡内显示"],["12","SHOW_ALL_HIDDEN_CARDS","？","？"],["13","EMPTY","不执行动作","不执行任何动作的占位符，一般用于出兵分支"],["14","E_NUM","？","执行特定函数动作"]]},{"title":"玩家操作的代理原理","rows":[["某次LS-4代理作战行动部分序列"],["行动序号","1","2","3","4","","……","11","12","13","14","15","16","……"],["操作与实时状态","部署","部署","部署","部署","阵亡","……","部署","技能","部署","部署","撤退","撤退","……"],["对象","红豆","蓝毒","空","凛冬","红豆","……","巡林者","空","Castle-3","红","巡林者","红","……"],["剩余部署位数量","7","6","5","4","5","……","1","1","1","0","1","2","……"]]},{"title":"玩家操作的代理原理","rows":[["某次LS-4代理作战行动部分序列"],["行动序号","1","2","3","4","'","……","11","12","13","14","14","15","16","……"],["操作与实时状态","部署","部署","部署","部署","存活","……","