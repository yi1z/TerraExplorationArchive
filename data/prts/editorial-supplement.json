    {
      "id": "prts-story-39850",
      "sourceTitle": "杰西卡/干员密录/1",
      "kind": "story",
      "summaryStatus": "curated",
      "sections": [
        {
          "title": "密录提要",
          "body": "杰西卡准备离开黑钢回到家族企业。雷神工业的瑞蒙以父亲的期望、她的伤势和不够出众的表现劝她回家；尽管装备测试同事认可她的判断，她仍把自己视为勉强合格的新人。雷蛇此时找到她，依据考核记录与耶兰德的推荐，邀请她担任副手。",
          "spoiler": true,
          "sourceKind": "curated"
        },
        {
          "title": "转折与选择",
          "body": "雷蛇用一次短暂对练检验她的射击和应变，说明经验不足不等于能力不合格。听到雷蛇坦言自己只是想做雇佣兵，杰西卡重新确认了外出见识他人生活的初衷。了解B.P.R.S.的感染风险与训练要求后，她撤销离职申请，并亲自请瑞蒙转告父亲：她要留在黑钢，通过保护他人寻找自己的道路。结尾父亲承认让瑞蒙说重话是为了试探她的决心，并接受她继续探索的选择。",
          "spoiler": true,
          "sourceKind": "curated"
        }
      ],
